<div class="size-requirements-body">
  <fieldset>
    <legend>{{localize "ROTTEN_HUNGER.Config.SizesLegend"}}</legend>
    <table>
      <thead>
        <tr>
          <th>{{localize "ROTTEN_HUNGER.Config.Table.Size"}}</th>
          <th>{{localize "ROTTEN_HUNGER.Config.Table.Food"}}</th>
          <th>{{localize "ROTTEN_HUNGER.Config.Table.Water"}}</th>
          <th>{{localize "ROTTEN_HUNGER.Config.Table.DaysWithoutFood"}}</th>
          <th>{{localize "ROTTEN_HUNGER.Config.Table.DaysWithoutWater"}}</th>
        </tr>
      </thead>
      <tbody>
        {{#each sizes}}
          <tr>
            <td>{{localize this.labelKey}}</td>
            <td><input type="number" name="{{this.key}}.food" value="{{this.food}}" min="0" step="0.1"></td>
            <td><input type="number" name="{{this.key}}.water" value="{{this.water}}" min="0" step="0.1"></td>
            <td><input type="number" name="{{this.key}}.daysWithoutFood" value="{{this.daysWithoutFood}}" min="0"></td>
            <td><input type="number" name="{{this.key}}.daysWithoutWater" value="{{this.daysWithoutWater}}" min="0"></td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  </fieldset>

  <fieldset>
    <legend>{{localize "ROTTEN_HUNGER.Config.SpoiledLegend"}}</legend>
    <div class="form-group">
      <label>{{localize "ROTTEN_HUNGER.Config.Spoiled.Food"}}</label>
      <select name="spoiledFoodItem">
        <option value="">{{localize "ROTTEN_HUNGER.Config.NoReplacement"}}</option>
        {{#each worldItems}}
          <option value="{{this.id}}" {{#if this.selectedFood}}selected{{/if}}>{{this.name}}</option>
        {{/each}}
      </select>
    </div>
    <div class="form-group">
      <label>{{localize "ROTTEN_HUNGER.Config.Spoiled.Drink"}}</label>
      <select name="spoiledDrinkItem">
        <option value="">{{localize "ROTTEN_HUNGER.Config.NoReplacement"}}</option>
        {{#each worldItems}}
          <option value="{{this.id}}" {{#if this.selectedDrink}}selected{{/if}}>{{this.name}}</option>
        {{/each}}
      </select>
    </div>
  </fieldset>

  <footer class="form-footer">
    <button type="submit"><i class="fas fa-save"></i> {{localize "ROTTEN_HUNGER.Config.Save"}}</button>
  </footer>
</div>